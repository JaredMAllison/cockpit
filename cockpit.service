[Unit]
Description=Cognitive Prosthetic Cockpit — unified HUD
After=network.target

[Service]
Type=simple
Environment=COCKPIT_PORT=9100
ExecStart=/usr/bin/python3 /home/jared/git/cockpit/cockpit.py
WorkingDirectory=/home/jared/git/cockpit
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
